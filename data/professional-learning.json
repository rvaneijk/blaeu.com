    {
      "year": 2023,
      "count": 6,
      "items": [
        {
          "id": "2023-cpdp-ppml-panel",
          "year": 2023,
          "title": "State-Of-Play Of Privacy-Preserving Machine Learning (PPML) - Auditing Bias, Mitigating Privacy Risks in ML-Systems",
          "authors": ["Carignan L.", "Kingsman N.", "Ruehle V.", "Shokri R."],
          "venue": "Computers, Privacy & Data Protection Conference (CPDP2023)",
          "location": "Brussels",
          "publisher": "Brussels Privacy Hub, Vrije Universiteit Brussels",
          "category": "professional learning",
          "mediaType": "video",
          "contentType": "training",
          "displayContext": "modal",
          "metadata": {
            "role": "Moderator - Eijk R. van"
          },
          "summary": "Rob van Eijk moderates a CPDP 2023 workshop on privacy-preserving machine learning, meant to help lawyers ask technologists the right questions. Lindsay Carignan and Nigel Kingsman of Holistic AI explain how they audit bias, with reference to New York City Local Law 144 and the EU AI Act. They contrast equality of outcome with equality of opportunity, show that reducing bias can cost accuracy and privacy, and list questions to ask data scientists. Victor Ruehle of Microsoft and Reza Shokri of the National University of Singapore turn to privacy risk. They use membership inference to measure how much a model leaks about its training data, with the open-source Privacy Meter. They also compare PII scrubbing with differential privacy, each of which trades some utility for privacy.",
          "links": [
            {
              "type": "video",
              "url": "https://www.youtube.com/watch?v=uzkgvRFFZjY",
              "title": "Watch recording",
              "status": "active",
              "lastChecked": "2026-10-25T11:33:58+01:00",
              "archiveUrls": []
            }
