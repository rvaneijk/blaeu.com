    {
      "year": 2020,
      "count": 6,
      "items": [
        {
          "id": "2020-blockchain-masterclass",
          "year": 2020,
          "title": "Understanding Blockchain",
          "authors": ["Artzt M.", "Laan J. van der"],
          "venue": "Digital Data Flows Masterclass",
          "location": "Brussels",
          "publisher": "Brussels Privacy Hub, Vrije Universiteit Brussels & Future of Privacy Forum",
          "category": "professional learning",
          "mediaType": "video",
          "contentType": "training",
          "displayContext": "modal",
          "summary": "Brenda Leong and Rob van Eijk of the Future of Privacy Forum host the eighth and final session of the Digital Data Flows Masterclass, on blockchain. Jake van der Laan of New Brunswick's Financial and Consumer Services Commission explains the technical basics through Bitcoin: an append-only transaction log, cryptographic hash functions that chain blocks together, proof-of-work consensus, and smart contracts on Ethereum. Matthias Artzt of Deutsche Bank then maps blockchain actors onto GDPR roles. Miners, nodes, and developers are neither controllers nor processors, he argues, while users may fall under the household exemption and governance bodies of private chains can be controllers. Because nobody can change data once it is on the chain, rectification and erasure are hard. Artzt reads erasure broadly as putting data beyond use and proposes \"hashing out\", which keeps personal data off-chain and stores only a hash on-chain. Once the controller deletes the off-chain data, the hash no longer points to anyone.",
          "metadata": {
            "moderators": "Eijk, R. & Leong B."
          },
          "links": [
            {
              "type": "video",
              "url": "https://youtu.be/nKpoWj1MQek",
              "title": "Watch recording",
              "status": "active",
              "lastChecked": "2026-10-25T11:34:09+01:00",
              "archiveUrls": []
            }
          ]
        },
