    {
      "year": 2022,
      "count": 2,
      "items": [
        {
          "id": "2022-cpdp-deidentification-masterclass",
          "year": 2022,
          "title": "Future of Privacy Masterclass: State-of-Play of De-Identification Techniques",
          "authors": ["Holohan N.", "Mosquera L.", "Rossi A.", "Stalla-Bourdillon S."],
          "venue": "Computers, Privacy & Data Protection Conference (CPDP2022)",
          "location": "Brussels",
          "publisher": "Brussels Privacy Hub, Vrije Universiteit Brussels & Future of Privacy Forum",
          "category": "professional learning",
          "mediaType": "video",
          "contentType": "training",
          "displayContext": "modal",
          "summary": "Rob van Eijk moderates a CPDP 2022 masterclass that explains de-identification techniques to a non-technical audience. He frames it with Recital 26 and the risks of singling out, linkability, and inference. Sophie Stalla-Bourdillon of Immuta and the University of Southampton presents homomorphic encryption. Each PET gives different guarantees and needs a risk assessment per party, she argues, and they work best in combination. Naoise Holohan of IBM Research explains differential privacy, which adds calibrated noise and uses epsilon to measure privacy loss. Nobody has yet issued guidelines for choosing epsilon. Lucy Mosquera of Replica Analytics covers synthetic data: how to generate it, how to measure its privacy risk, and its uncertain regulatory status. For DPOs, the session's advice is to talk to data scientists early and ask them to explain their risk metrics.",
          "metadata": {
            "role": "Moderator - Eijk R. van"
          },
          "links": [
            {
              "type": "video",
              "url": "https://www.youtube.com/watch?v=r1J93rTeeaY",
              "title": "Watch recording",
              "status": "active",
              "lastChecked": "2026-10-25T11:34:06+01:00",
              "archiveUrls": []
            }
          ]
        },
        {
          "id": "2022-cpra-universal-opt-outs",
          "year": 2022,
          "title": "Session 5: Universal Opt-Outs and Global Privacy Controls",
          "authors": ["Vyas T.", "Eijk R. van"],
          "venue": "CPRA Law + Tech Series: Understanding Data, Decisionmaking, and Design",
          "location": "Washington, DC",
          "publisher": "Future of Privacy Forum & California Lawyers Association",
          "category": "professional learning",
          "mediaType": "video",
          "contentType": "training",
          "displayContext": "modal",
          "summary": "Tanvi Vyas of Mozilla and Rob van Eijk of the Future of Privacy Forum give the fifth session of the CPRA Law and Tech Series, hosted by Stacey Gray of FPF and Sheri Porath Rockwell of the California Lawyers Association. Van Eijk takes apart a display ad and the browser to show where cookies and other storage live. He also shows how Chrome, Firefox, and Safari differ in handling third-party cookies by default. Vyas traces opt-out cookies, the failure of Do Not Track without legal backing, and today's confusing consent banners. She presents the Global Privacy Control header and argues that it needs clear legal backing, because its enforceability under the CCPA is still ambiguous. Van Eijk gives two examples of machine-readable signals: the _nomap Wi-Fi opt-out from the Dutch DPA's Google Street View case, and noyb's Advanced Data Protection Control for consent and withdrawal under EU law. He ends by stressing that defaults and definitions both matter.",
          "metadata": {
            "moderator": "Gray S."
          },
          "links": [
            {
              "type": "video",
              "url": "https://www.youtube.com/watch?v=MauPHIRmUmc",
              "title": "Watch recording",
              "status": "active",
              "lastChecked": "2026-10-25T11:34:07+01:00",
              "archiveUrls": []
            }
          ]
        }
      ]
    },
